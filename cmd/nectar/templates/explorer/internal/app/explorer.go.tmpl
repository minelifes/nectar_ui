package app

import (
	"context"
	"fmt"
	"io/fs"
	"path"
	"strings"
	"unicode/utf8"

	"[[.Engine]]/ui/geom"
	m "[[.Engine]]/ui/material"
	"[[.Engine]]/ui/material/icons"
	w "[[.Engine]]/ui/widgets"
)

// Explorer is a resizable file tree next to a preview of the selected file.
type Explorer struct {
	FS           fs.FS
	Name         string
	Dark         bool
	OnToggleDark func()
}

func (Explorer) CreateState() w.State { return &explorerState{tree: w.NewTreeController()} }

type explorerState struct {
	w.StateBase
	tree    *w.TreeController
	path    string
	preview string
	image   w.ImageSource // set when the selection is a picture
}

func (s *explorerState) Build(ctx w.BuildContext) w.Widget {
	e := w.WidgetOf[Explorer](s)
	th := m.ThemeOf(ctx)
	sc := th.Scheme

	themeIcon := icons.DarkMode
	if e.Dark {
		themeIcon = icons.LightMode
	}
	title := "Select a file"
	if s.path != "" {
		title = s.path
	}
	var body w.Widget = w.ScrollView{ThumbColor: sc.OnSurface.WithAlpha(0.3),
		Child: w.Text{Text: s.preview, Style: m.Styled(th.Text.BodyMedium, sc.OnSurfaceVariant)}}
	if s.image != nil {
		body = w.Image{Source: s.image, Fit: w.FitScaleDown, Radius: 8,
			Placeholder: w.Center{Child: m.CircularProgressIndicator{}},
			Error: func(err error) w.Widget {
				return w.Text{Text: err.Error(), Style: m.Styled(th.Text.BodyMedium, sc.Error)}
			}}
	}
	preview := w.Column{Cross: w.CrossStretch, Spacing: 12, Children: []w.Widget{
		w.Text{Text: title, Style: m.Styled(th.Text.TitleMedium, sc.OnSurface), MaxLines: 1, Ellipsis: true},
		w.Expanded{Child: body},
	}}
	return m.Scaffold{
		AppBar: m.AppBar{Title: e.Name, Actions: []w.Widget{
			m.Tooltip{Message: "Collapse all", Child: m.IconButton{Icon: icons.UnfoldLess, OnPressed: s.tree.CollapseAll}},
			m.Tooltip{Message: "Reload", Child: m.IconButton{Icon: icons.Refresh, OnPressed: func() { s.tree.Reload("") }}},
			m.Tooltip{Message: "Toggle dark mode", Child: m.IconButton{Icon: themeIcon, OnPressed: e.OnToggleDark}},
		}},
		Body: w.Padding{Padding: geom.InsetsLTRB(16, 0, 16, 16), Child: m.SplitView{Panes: []w.Pane{
			{Min: 200, Max: 520, Size: 300, Child: m.Card{Variant: m.CardOutlined, Padding: geom.InsetsHV(0, 8),
				Child: m.FileTree{FS: e.FS, Controller: s.tree, ShowGuides: true,
					OnSelect: s.show,
					OnOpen:   func(p string) { m.ShowSnackBar(ctx, m.SnackBar{Message: "Open " + p}) },
				}}},
			{Min: 280, Child: m.Card{Variant: m.CardFilled, Padding: geom.Insets(20), Child: preview}},
		}}},
	}
}

func (s *explorerState) show(p string, d fs.DirEntry) {
	fsys := w.WidgetOf[Explorer](s).FS
	s.SetState(func() {
		s.path, s.preview, s.image = p, "", nil
		switch {
		case d == nil || d.IsDir():
		case isImage(p):
			s.image = fileImage{fsys, p}
		default:
			s.preview = previewFile(fsys, p)
		}
	})
}

func isImage(p string) bool {
	switch strings.ToLower(path.Ext(p)) {
	case ".png", ".jpg", ".jpeg", ".gif", ".webp", ".bmp", ".tif", ".tiff":
		return true
	}
	return false
}

// fileImage is an image source reading from the browsed fs.FS (a custom
// widgets.ImageSource: a cache key and a loader).
type fileImage struct {
	fsys fs.FS
	path string
}

func (f fileImage) CacheKey() string {
	key := "explorer:" + f.path
	if st, err := fs.Stat(f.fsys, f.path); err == nil { // changed file → new key
		key += fmt.Sprintf("@%d-%d", st.ModTime().UnixNano(), st.Size())
	}
	return key
}

func (f fileImage) Load(context.Context) ([]byte, error) { return fs.ReadFile(f.fsys, f.path) }

// previewFile returns the start of a text file.
func previewFile(fsys fs.FS, p string) string {
	if st, err := fs.Stat(fsys, p); err != nil || st.Size() > 512<<10 {
		return "(too large to preview)"
	}
	data, err := fs.ReadFile(fsys, p)
	if err != nil {
		return err.Error()
	}
	if !utf8.Valid(data) || strings.ContainsRune(string(data), 0) {
		return "(binary file)"
	}
	lines := strings.Split(string(data), "\n")
	if len(lines) > 200 {
		lines = append(lines[:200], "…")
	}
	return strings.ReplaceAll(strings.Join(lines, "\n"), "\t", "    ")
}
