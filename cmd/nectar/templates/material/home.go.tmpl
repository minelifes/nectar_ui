package main

import (
	"fmt"

	"[[.Engine]]/ui/geom"
	m "[[.Engine]]/ui/material"
	"[[.Engine]]/ui/material/icons"
	w "[[.Engine]]/ui/widgets"
)

// HomePage is the first screen: a counter with an app bar and a FAB.
type HomePage struct {
	Title        string
	Dark         bool
	OnToggleDark func()
}

func (HomePage) CreateState() w.State { return &homeState{} }

type homeState struct {
	w.StateBase
	count int
}

func (s *homeState) Build(ctx w.BuildContext) w.Widget {
	p := w.WidgetOf[HomePage](s)
	th := m.ThemeOf(ctx)
	sc := th.Scheme

	themeIcon := icons.DarkMode
	if p.Dark {
		themeIcon = icons.LightMode
	}
	return m.Scaffold{
		AppBar: m.AppBar{Title: p.Title, Actions: []w.Widget{
			m.Tooltip{Message: "Toggle dark mode", Child: m.IconButton{Icon: themeIcon, OnPressed: p.OnToggleDark}},
		}},
		Body: w.Center{Child: w.Column{ShrinkMain: true, Cross: w.CrossCenter, Spacing: 16, Children: []w.Widget{
			w.Text{Text: "You have pressed the button this many times:", Style: m.Styled(th.Text.BodyLarge, sc.OnSurfaceVariant)},
			w.Text{Text: fmt.Sprint(s.count), Style: m.Styled(th.Text.DisplayMedium, sc.Primary)},
			w.Padding{Padding: geom.InsetsLTRB(0, 8, 0, 0), Child: m.OutlinedButton{Label: "Reset", OnPressed: s.reset}},
		}}},
		FAB: m.FloatingActionButton{Icon: icons.Add, Label: "Add", OnPressed: s.increment},
	}
}

func (s *homeState) increment() { s.SetState(func() { s.count++ }) }
func (s *homeState) reset()     { s.SetState(func() { s.count = 0 }) }
