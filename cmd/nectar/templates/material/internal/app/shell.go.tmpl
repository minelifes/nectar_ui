package app

import (
	m "[[.Engine]]/ui/material"
	"[[.Engine]]/ui/material/icons"
	w "[[.Engine]]/ui/widgets"

	"[[.Module]]/internal/state"
)

// Shell is the frame around the pages: app bar and navigation rail.
type Shell struct{}

func (Shell) CreateState() w.State { return &shellState{} }

type shellState struct {
	w.StateBase
	path   string
	router *Router
}

func (s *shellState) InitState() {
	if len(Routes) > 0 {
		s.path = CleanPath(Routes[0].Path)
	}
	s.router = &Router{show: func(p string) { s.SetState(func() { s.path = p }) }}
}

func (s *shellState) Build(ctx w.BuildContext) w.Widget {
	st := state.Of(ctx)
	page, _ := RouteFor(s.path)
	// The rail lists the routes that aren't Hidden.
	var dests []m.NavigationDestination
	var paths []string
	selected := -1
	for _, r := range Routes {
		if r.Hidden {
			continue
		}
		if CleanPath(r.Path) == s.path {
			selected = len(dests)
		}
		dests = append(dests, m.NavigationDestination{Icon: r.Icon, Label: r.Label})
		paths = append(paths, CleanPath(r.Path))
	}
	themeIcon := icons.DarkMode
	if st.Dark {
		themeIcon = icons.LightMode
	}
	return m.Scaffold{
		AppBar: m.AppBar{Title: Title, Actions: []w.Widget{
			m.Tooltip{Message: "Toggle dark mode", Child: m.IconButton{Icon: themeIcon, OnPressed: func() {
				state.Update(ctx, func(s *state.Settings) { s.Dark = !s.Dark })
			}}},
		}},
		Rail: m.NavigationRail{Destinations: dests, Selected: selected,
			OnSelected: func(i int) { s.router.show(paths[i]) }},
		// The pages reach the router with Go / CurrentPath; KeyedSubtree
		// gives each page fresh state when switching.
		Body: w.Provider[*Router]{Value: s.router, Child: w.Provider[currentPath]{Value: currentPath(s.path),
			Child: w.KeyedSubtree{ID: s.path, Child: Routes[page].Page()}}},
	}
}
