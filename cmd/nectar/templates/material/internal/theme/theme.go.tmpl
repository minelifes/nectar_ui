// Package theme is the app's look: brand color, light/dark Material 3
// themes, typography tweaks and layout tokens. Change it here and every
// page follows.
package theme

import (
	"[[.Engine]]/ui/geom"
	m "[[.Engine]]/ui/material"
)

// Seed is the brand color. The whole M3 palette (primary, secondary,
// tertiary, surfaces, …) is generated from it, for light and dark.
var Seed = geom.Hex([[.Seed]])

// NamedColor is a selectable seed on the settings page.
type NamedColor struct {
	Name  string
	Color geom.Color
}

// Seeds are the accent colors users can pick on the settings page: the
// brand color first, then presets (minus any equal to the brand color).
var Seeds = withBrand(Seed, []NamedColor{
	{"Blue", geom.Hex(0x0B57D0)},
	{"Teal", geom.Hex(0x006A6A)},
	{"Green", geom.Hex(0x386A20)},
	{"Orange", geom.Hex(0x8B5000)},
	{"Rose", geom.Hex(0xB3261E)},
})

func withBrand(brand geom.Color, presets []NamedColor) []NamedColor {
	out := []NamedColor{{"Brand", brand}}
	for _, p := range presets {
		if p.Color != brand {
			out = append(out, p)
		}
	}
	return out
}

// Light returns the light theme for seed.
func Light(seed geom.Color) m.Theme { return build(seed, false) }

// Dark returns the dark theme for seed.
func Dark(seed geom.Color) m.Theme { return build(seed, true) }

func build(seed geom.Color, dark bool) m.Theme {
	t := m.NewTheme(seed, dark)

	// Customize the generated theme here. Colors: any role of the M3
	// scheme, e.g.
	//
	//	t.Scheme.Tertiary = geom.Hex(0x7D5260)
	//	t.Scheme.Surface = geom.Hex(0xFFFBFE)
	//
	// Typography: every style of the M3 type scale (Display…Label), e.g.
	// a bigger, tighter headline for page titles:
	t.Text.HeadlineMedium.Size = 30
	t.Text.HeadlineMedium.LetterSpacing = -0.25

	// To design the themes visually, run `nectar theme` in the app folder:
	// it writes theme_light.go (LightTheme) and theme_dark.go (DarkTheme)
	// next to this file; then return those from Light and Dark.
	//
	// Components: every Material widget has a theme here (t.FilledButton,
	// t.Card, t.Input, t.NavigationBar, …); set only what you want to
	// change. Colors left zero keep the scheme's; sizes are pointers
	// (m.Dp(8)) because 0 is a valid value. A widget's own Style field
	// still wins over these. For example, flatter cards:
	//
	//	t.Card = m.CardTheme{Elevation: w.Ptr(0), BorderWidth: m.Dp(1)}
	//	t.FilledButton = m.ButtonStyle{Radius: m.Dp(12)}
	return t
}
